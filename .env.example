# ==========================================================================
# PLANTILLA DE VARIABLES DE ENTORNO PARA VERCEL Y DESARROLLO LOCAL
# Copia este archivo como .env.local en local, o configura estas claves en:
# Vercel Dashboard -> Settings -> Environment Variables
# ==========================================================================

# 1. Configuración de Firebase Firestore
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_COLLECTION=reservas

# 2. Google Apps Script (Espejo a Google Sheets y Bot de Telegram)
GOOGLE_SCRIPT_URL=

# 3. Credenciales del Panel Privado de Organizadoras
USUARIO_PRIVADO=
CONTRASENA_PRIVADA=
